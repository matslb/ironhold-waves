{
  "name": "ironhold",
  "version": "0.1.0",
  "private": true,
  "description": "Ironhold browser game",
  "scripts": {
    "check": "node --check src/main.js && node --check src/content/rpg.js && node --check src/content/dialogue.js",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1",
    "firebase:serve": "npx firebase-tools@15.20.0 emulators:start --only hosting",
    "firebase:deploy": "npx firebase-tools@15.20.0 deploy --only hosting"
  }
}
